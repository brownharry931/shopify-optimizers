generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Shopify-managed session tokens only. Never add payment credentials here.
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  CANCELLED
  DECLINED
  EXPIRED
  FROZEN
  UNKNOWN
}

// Current verified Shopify subscription snapshot per shop. No payment card data.
model Subscription {
  id                   String             @id @default(cuid())
  shop                 String             @unique
  shopifySubscriptionId String?            @unique
  planName             String
  price                Decimal            @db.Decimal(10, 2)
  currency             String
  interval             String
  status               SubscriptionStatus @default(UNKNOWN)
  trialDays            Int                @default(0)
  isTest               Boolean            @default(false)
  shopifyCreatedAt     DateTime?
  trialEndsAt          DateTime?
  cancelledAt          DateTime?
  expiresAt            DateTime?
  cancelAtEndOfCycle   Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status, updatedAt])
}
