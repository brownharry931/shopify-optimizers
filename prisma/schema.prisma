generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Shopify-managed session tokens only. Never add payment credentials here.
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  CANCELLED
  DECLINED
  EXPIRED
  FROZEN
  UNKNOWN
}

// Current verified Shopify subscription snapshot per shop. No payment card data.
model Subscription {
  id                   String             @id @default(cuid())
  shop                 String             @unique
  shopifySubscriptionId String?            @unique
  planName             String
  price                Decimal            @db.Decimal(10, 2)
  currency             String
  interval             String
  status               SubscriptionStatus @default(UNKNOWN)
  trialDays            Int                @default(0)
  isTest               Boolean            @default(false)
  shopifyCreatedAt     DateTime?
  trialEndsAt          DateTime?
  cancelledAt          DateTime?
  expiresAt            DateTime?
  cancelAtEndOfCycle   Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status, updatedAt])
}

// A real storefront signal proving the App Embed runtime executed in a shop.
model ThemeEmbedHeartbeat {
  shop       String   @id
  lastSeenAt DateTime @default(now())
  pageLoads  Int      @default(1)
}

// A merchant-requested audit of one same-store path on one or more device strategies.
model AuditRun {
  id          String           @id @default(cuid())
  shop        String
  targetPath  String
  pageUrl     String
  template    String
  strategies  String[]
  status      String           @default("RUNNING")
  error       String?
  createdAt   DateTime         @default(now())
  completedAt DateTime?
  scans       PerformanceScan[]

  @@index([shop, createdAt])
  @@index([shop, status])
}

// Synthetic Lighthouse/PageSpeed results. These are never presented as field data.
model ThemeAssetChange {
  id             String   @id @default(cuid())
  shop           String
  themeId        String
  themeName      String
  filename       String
  activeKey      String?  @unique
  originalContent String  @db.Text
  sourceHash     String
  optimizedHash  String
  originalBytes  Int
  optimizedBytes Int
  status         String   @default("PREPARED")
  shopifyJobId   String?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  appliedAt      DateTime?
  rolledBackAt   DateTime?

  @@index([shop, createdAt])
  @@index([shop, themeId, filename])
  @@index([shop, status])
}

model PerformanceScan {
  id             String    @id @default(cuid())
  shop           String
  auditRunId     String?
  auditRun       AuditRun? @relation(fields: [auditRunId], references: [id], onDelete: SetNull)
  pageUrl        String
  template       String    @default("home")
  strategy       String    @default("mobile")
  status         String    @default("RUNNING")
  performance    Int?
  lcpMs          Int?
  tbtMs          Int?
  cls            Float?
  fcpMs          Int?
  speedIndexMs   Int?
  fieldDataSource String?
  fieldData       Json?
  findings       Json?
  error          String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([shop, createdAt])
  @@index([shop, status])
  @@index([auditRunId, strategy])
}
