# Copy to .env for local-only development. Never commit .env or real secrets.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://example.invalid
SCOPES=read_themes
SHOP_CUSTOM_DOMAIN=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/performance_pro?sslmode=require

# Performance Pro is centrally fixed at USD 10 every 30 days.
# Trial is intentionally disabled by default; billing test mode is on locally.
PLAN_INTERVAL=EVERY_30_DAYS
TRIAL_DAYS=0
BILLING_TEST_MODE=true
