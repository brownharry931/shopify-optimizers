# Copy to .env for local-only development. Never commit .env or real secrets.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://example.invalid
SCOPES=
SHOP_CUSTOM_DOMAIN=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/performance_pro?sslmode=require

# Shopify App Pricing / Partner API verification. Keep the access token private.
# Create a Partner API client with Manage apps permission.
SHOPIFY_PARTNER_ORG_ID=2522432
SHOPIFY_PARTNER_API_ACCESS_TOKEN=
SHOPIFY_APP_GID=gid://shopify/App/395164614657
SHOPIFY_APP_HANDLE=speedboost-v2-1

# The public offer is configured in Shopify App Pricing, not in these variables.
# Expected offer: USD 10/month; configure any production trial there (default: none).
# Use Shopify's private no-charge test plan on development stores.

# Optional Google PageSpeed Insights API key for higher scan quota.
# Scans are marked synthetic lab data and remain subject to provider limits.
GOOGLE_PAGESPEED_API_KEY=
